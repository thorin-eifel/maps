<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- launchd-Job: Live-Schleife (Flüge alle 15 s). Läuft dauernd, startet nach Absturz neu.
     Installation: siehe README, Abschnitt "Live-Daten". -->
<plist version="1.0">
<dict>
  <key>Label</key><string>de.ctw.osint-live</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>set -a; [ -f .env ] &amp;&amp; . ./.env; set +a; exec .venv/bin/python -m app.live</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/thorin/Claude/OSINT</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/thorin/Library/Logs/osint-live.log</string>
  <key>StandardErrorPath</key><string>/Users/thorin/Library/Logs/osint-live.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
