# Kopie nach .env im Projektordner, Rechte 600. .env gehört nicht ins Repository.

# --- Sammelstelle ---
# Ehrlicher Absender im User-Agent der Collector (Abschnitt 4.4 der Projektanweisung)
OSINT_CONTACT=kontakt@example.invalid   # echte Adresse eintragen: steht im User-Agent gegenüber den Quellen
# OSINT_DB_PATH=data/osint.sqlite
# OSINT_HTTP_TIMEOUT=20
# OSINT_RETENTION_DAYS=30
# Phase 2: Zugangsdaten (z. B. Tankerkönig) nur hier, nie im Code
# TANKERKOENIG_API_KEY=

# --- Upload auf den IONOS-Webspace (deploy/publish.sh) ---
PUBLISH_ENABLED=0
IONOS_SFTP_HOST=
IONOS_SFTP_USER=
IONOS_SFTP_KEY=
# oder, weniger schön: IONOS_SFTP_PASSWORD=
IONOS_REMOTE_DIR=/
